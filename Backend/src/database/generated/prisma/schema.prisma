// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Esquemas

enum Role {
  ADMINISTRADOR
  CLIENTE
}

model Usuario {
  id        String  @id @default(uuid()) @db.VarChar(36)
  nome      String
  email     String  @unique
  senhaHash String  @map("senha_hash")
  cpf       String  @unique
  telefone  String
  bloqueado Boolean @default(false)
  role      Role    @default(CLIENTE)

  emprestimos Emprestimo[]
  avaliacoes  Avaliacao[]
}

//-----------Início parte livros
enum LivroStatus {
  Disponivel
  Emprestado
  // futuramente: Manutencao (caso o livro esteja danificado), Reservado
}

model Livro {
  id              Int    @id @default(autoincrement())
  isbn            String @unique
  mediaAvaliacoes Float  @default(0.0) @map("media_avaliacoes")

  exemplares ExemplarLivro[]
  avaliacoes Avaliacao[]
}

model Avaliacao {
  id           Int      @id @default(autoincrement())
  nota         Int
  comentario   String?  @db.Text
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  usuarioId    String   @map("usuario_id") @db.VarChar(36)
  livroId      Int      @map("livro_id")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  livro   Livro   @relation(fields: [livroId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, livroId])
}

model ExemplarLivro {
  id      Int         @id @default(autoincrement())
  livroId Int
  status  LivroStatus @default(Disponivel)

  livro Livro            @relation(fields: [livroId], references: [id])
  itens ItemEmprestimo[]
}

//-----------Fim parte livros

model Emprestimo {
  id         Int      @id @default(autoincrement())
  usuarioId  String   @map("usuario_id") @db.VarChar(36)
  data_saida DateTime @default(now())

  // Um empréstimo pode ter vários itens (livros diferentes)
  itens   ItemEmprestimo[]
  usuario Usuario          @relation(fields: [usuarioId], references: [id])
}

model ItemEmprestimo {
  id             Int       @id @default(autoincrement())
  emprestimoId   Int
  exemplarId     Int
  count_adiar    Int       @default(5) // Quantidade de vezes que o cliente pode adiar o emprestimo
  data_prazo     DateTime // Data para marcar o prazo de entrega  
  data_devolucao DateTime? // Data para marcar o dia da entrega

  emprestimo    Emprestimo    @relation(fields: [emprestimoId], references: [id], onDelete: Cascade)
  exemplarLivro ExemplarLivro @relation(fields: [exemplarId], references: [id])
}

model Configuracao {
  id                Int @id @default(1)
  limite_global     Int @default(5) // Total de livros na sacola
  limite_por_titulo Int @default(2) // Total de cópias do mesmo livro
  prazo_padrao_dias Int @default(7) // Quantos dias dura o empréstimo
  dias_penalidade   Int @default(7) // Quanto tempo dura o bloqueio por atraso
}
